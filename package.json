{
  "name": "nanti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:index-products": "node --env-file-if-exists=.env --import tsx server/backfill-identities.ts",
    "admin:hash": "node --import tsx scripts/hash-admin-password.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json && node scripts/build-web.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:browser:affiliate": "node --import tsx tests/browser-affiliate.mjs",
    "test:browser:accounts": "node --import tsx tests/browser-accounts.mjs",
    "test:browser:creator": "node --import tsx tests/browser-creator-catalog.mjs",
    "test:browser:creator-design": "node tests/browser-creator-design.mjs",
    "test:browser:visual": "node tests/browser-visual.mjs",
    "test:browser:mvp": "node tests/browser-mvp.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "3.11.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.77.0",
    "mariadb": "3.5.4",
    "openid-client": "^6.9.0",
    "parse5": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.1",
    "playwright-core": "^1.65.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
