DATABASE_URL=
SESSION_SECRET=
PORT=3000
NANTI_DEV_WEB_PORT=5173
HOST=127.0.0.1
NODE_ENV=development
NANTI_TRUST_PROXY=
NANTI_ADMIN_USERNAME=
NANTI_ADMIN_PASSWORD_HASH=

# Set to granted only if the retailer has explicitly authorized metadata retrieval and reuse.
NANTI_IKEA_METADATA_PERMISSION=
NANTI_IKEA_PRICE_METADATA_PERMISSION=

# Leave provider credentials blank to allow guest mode without consumer sign-in.
# Register <AUTH_PUBLIC_ORIGIN>/api/account/google/callback in each Google OAuth client.
AUTH_PUBLIC_ORIGIN=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY_BASE64=

# Optional S3-compatible private product-image storage (Cloudflare R2 or self-hosted S3).
# Leave all blank to disable uploads. Use HTTPS and a private bucket.
NANTI_S3_ENDPOINT=
NANTI_S3_BUCKET=
NANTI_S3_REGION=
NANTI_S3_ACCESS_KEY_ID=
NANTI_S3_SECRET_ACCESS_KEY=

# Opt-in localhost-only account mail outbox. Recovery links are written to .env.account-outbox.
NANTI_DEV_ACCOUNT_MAIL=
