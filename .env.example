DATABASE_URL=
SESSION_SECRET=
PORT=3000
NANTI_DEV_WEB_PORT=5173
HOST=127.0.0.1
NODE_ENV=development
NANTI_TRUST_PROXY=
NANTI_ADMIN_USERNAME=
NANTI_ADMIN_PASSWORD_HASH=

# Set to granted only if the retailer has explicitly authorized metadata retrieval and reuse.
NANTI_IKEA_METADATA_PERMISSION=
NANTI_IKEA_PRICE_METADATA_PERMISSION=

# Leave provider credentials blank to allow guest mode without consumer sign-in.
# Register <AUTH_PUBLIC_ORIGIN>/api/account/google/callback in each Google OAuth client.
AUTH_PUBLIC_ORIGIN=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY_BASE64=

# New wishlist photos use MySQL. Optional private legacy bucket settings preserve existing photo reads.
# Leave blank for a fresh install. Use the original HTTPS endpoint and read credentials.
# Cloudflare R2 legacy bucket. R2_PUBLIC_BASE_URL is optional and unused.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# An existing complete S3 configuration takes precedence to preserve existing objects.
NANTI_S3_ENDPOINT=
NANTI_S3_BUCKET=
NANTI_S3_REGION=
NANTI_S3_ACCESS_KEY_ID=
NANTI_S3_SECRET_ACCESS_KEY=

# Opt-in localhost-only account mail outbox. Recovery links are written to .env.account-outbox.
NANTI_DEV_ACCOUNT_MAIL=

# Optional production account email through Resend. Use a verified sender domain.
# Requires AUTH_PUBLIC_ORIGIN to be the bare public HTTPS origin.
NANTI_ACCOUNT_MAIL_API_KEY=
NANTI_ACCOUNT_MAIL_FROM=
