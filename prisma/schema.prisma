generator client {
  provider = "prisma-client"
  output = "../server/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Char(36)
  ownerId   String   @db.Char(36)
  name      String   @db.VarChar(100)
  currency  String   @db.Char(3)
  createdAt DateTime @default(now())
  items     Item[]
  assessments Assessment[]
  dataOwner DataOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, id])
  @@index([ownerId, createdAt])
}

model Item {
  id           String   @id @default(uuid()) @db.Char(36)
  ownerId      String   @db.Char(36)
  wishlistId   String   @db.Char(36)
  name         String   @db.VarChar(160)
  url          String?  @db.VarChar(2048)
  priceMinor   Int?
  quantity     Int
  imageData    String?  @db.MediumText
  createdAt    DateTime @default(now())
  wishlist     Wishlist @relation(fields: [ownerId, wishlistId], references: [ownerId, id], onDelete: Cascade)
  assessments  Assessment[]
  productIdentityId String? @db.Char(36)
  productIdentity   ProductIdentity? @relation(fields: [productIdentityId], references: [id], onDelete: SetNull)
  priceObservations PriceObservation[]
  priceTarget       PriceTarget?

  @@unique([ownerId, wishlistId, id])
  @@index([ownerId, wishlistId, createdAt])
  @@index([productIdentityId])
}

enum PriceSource {
  existing
  manual
  imported_unverified
  marketplace_verified
}

model PriceObservation {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  ownerId     String      @db.Char(36)
  wishlistId  String      @db.Char(36)
  itemId      String      @db.Char(36)
  priceMinor  Int
  currency    String      @db.Char(3)
  source      PriceSource
  observedAt  DateTime    @default(now())
  item        Item        @relation(fields: [ownerId, wishlistId, itemId], references: [ownerId, wishlistId, id], onDelete: Cascade)
  alert       PriceAlert?

  @@index([ownerId, wishlistId, itemId, id])
  @@index([itemId, source, id])
}

model PriceTarget {
  itemId        String    @id @db.Char(36)
  ownerId       String    @db.Char(36)
  wishlistId    String    @db.Char(36)
  priceMinor    Int
  notify        Boolean   @default(true)
  lastReachedAt DateTime?
  item          Item      @relation(fields: [ownerId, wishlistId, itemId], references: [ownerId, wishlistId, id], onDelete: Cascade)

  @@unique([ownerId, wishlistId, itemId])
}

model PriceAlert {
  id            String           @id @default(uuid()) @db.Char(36)
  observationId BigInt           @unique @db.UnsignedBigInt
  targetMinor   Int
  readAt        DateTime?
  observation   PriceObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([readAt, observationId])
}

enum AssessmentKind {
  impulse
  comparison
  timing
}

model Assessment {
  id          String         @id @default(uuid()) @db.Char(36)
  ownerId     String         @db.Char(36)
  wishlistId  String         @db.Char(36)
  itemId      String?        @db.Char(36)
  kind        AssessmentKind
  version     String         @db.VarChar(24)
  input       Json
  result      Json
  snapshot    Json?
  financial   Json?
  requestKey  String?        @db.Char(36)
  requestHash String?        @db.Char(64)
  createdAt   DateTime       @default(now())
  wishlist    Wishlist       @relation(fields: [ownerId, wishlistId], references: [ownerId, id], onDelete: Cascade)
  item        Item?          @relation(fields: [ownerId, wishlistId, itemId], references: [ownerId, wishlistId, id], onDelete: Cascade)

  @@index([ownerId, wishlistId, itemId, kind, createdAt, id])
  @@unique([ownerId, requestKey])
  @@index([createdAt])
}

model IntelligencePreference {
  ownerId        String @id @db.Char(36)
  coolingOffDays Int
  updatedAt      DateTime @default(now()) @updatedAt
  dataOwner      DataOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model ProductIdentity {
  id              String   @id @default(uuid()) @db.Char(36)
  lookupKey       String   @unique @db.Char(64)
  merchant        String   @db.VarChar(64)
  market          String   @db.VarChar(16)
  listingId       String   @db.VarChar(80)
  canonicalUrl    String   @db.VarChar(2048)
  title           String?  @db.VarChar(160)
  normalizedTitle String?  @db.VarChar(220)
  brand           String?  @db.VarChar(120)
  model           String?  @db.VarChar(120)
  sellerId        String?  @db.VarChar(120)
  variants        Json?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  items           Item[]
  mappings        AffiliateMapping[] @relation("IdentityMappings")
  activeMapping   AffiliateMapping? @relation("ActiveAffiliateMapping")
  audit           AffiliateAudit[]
  notifications   AdminNotification[]

  @@index([createdAt, id])
}

enum AffiliateStatus {
  pending
  approved
  rejected
  disabled
  revoked
  invalid
}

enum MatchClassification {
  verified_exact
  potential
  mismatch
  insufficient
}

model AffiliateMapping {
  id               String @id @default(uuid()) @db.Char(36)
  identityId       String @db.Char(36)
  activeIdentityId String? @unique @db.Char(36)
  originalUrl      String @db.VarChar(2048)
  affiliateUrl     String @db.VarChar(2048)
  candidateKey     String @db.Char(64)
  status           AffiliateStatus @default(pending)
  classification   MatchClassification
  evidence         Json?
  approvedBy       String? @db.VarChar(64)
  approvedAt       DateTime?
  validatedAt      DateTime?
  revision         Int @default(0)
  createdAt        DateTime @default(now())
  identity         ProductIdentity @relation("IdentityMappings", fields: [identityId], references: [id], onDelete: Restrict)
  activeIdentity   ProductIdentity? @relation("ActiveAffiliateMapping", fields: [activeIdentityId], references: [id], onDelete: Restrict)
  audit            AffiliateAudit[]

  @@unique([identityId, candidateKey])
  @@index([identityId, createdAt, id])
}

model AffiliateAudit {
  id         String @id @default(uuid()) @db.Char(36)
  identityId String @db.Char(36)
  mappingId  String @db.Char(36)
  actor      String @db.VarChar(64)
  action     String @db.VarChar(32)
  details    Json
  createdAt  DateTime @default(now())
  identity   ProductIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  mapping    AffiliateMapping @relation(fields: [mappingId], references: [id], onDelete: Restrict)

  @@index([identityId, createdAt, id])
}

model AdminNotification {
  id          String @id @default(uuid()) @db.Char(36)
  eventKey    String @unique @db.VarChar(120)
  identityId  String @db.Char(36)
  kind        String @db.VarChar(32)
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
  identity    ProductIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([dismissedAt, createdAt, id])
}

model AdminSession {
  tokenHash       String @id @db.Char(64)
  credentialScope String @db.Char(64)
  expiresAt       DateTime

  @@index([expiresAt])
}

model User {
  id          String         @id @default(uuid()) @db.Char(36)
  displayName String?        @db.VarChar(100)
  createdAt   DateTime       @default(now())
  identities  AuthIdentity[]
  sessions    UserSession[]
  dataOwners  DataOwner[]
}

model DataOwner {
  id         String                  @id @db.Char(36)
  userId     String?                 @db.Char(36)
  user       User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlists  Wishlist[]
  preference IntelligencePreference?

  @@index([userId])
}

enum AuthProvider {
  google
  apple
}

model AuthIdentity {
  provider    AuthProvider
  subjectHash String       @db.Char(64)
  userId      String       @db.Char(36)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subjectHash])
  @@unique([userId, provider])
}

model UserSession {
  tokenHash           String         @id @db.Char(64)
  userId              String         @db.Char(36)
  pendingGuestOwnerId String?        @db.Char(36)
  expiresAt           DateTime
  verifiedAt          DateTime
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts            OAuthAttempt[]

  @@index([userId])
  @@index([expiresAt])
}

enum AuthPurpose {
  signin
  link
  verify
}

model OAuthAttempt {
  stateHash      String       @id @db.Char(64)
  browserHash    String       @db.Char(64)
  provider       AuthProvider
  purpose        AuthPurpose
  nonce          String       @db.VarChar(64)
  verifier       String?      @db.VarChar(128)
  guestOwnerId   String?      @db.Char(36)
  sessionHash    String?      @db.Char(64)
  expiresAt      DateTime
  session        UserSession? @relation(fields: [sessionHash], references: [tokenHash], onDelete: Cascade)

  @@index([sessionHash])
  @@index([expiresAt])
}
