generator client {
  provider = "prisma-client"
  output = "../server/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Char(36)
  ownerId   String   @db.Char(36)
  name      String   @db.VarChar(100)
  currency  String   @db.Char(3)
  createdAt DateTime @default(now())
  items     Item[]
  assessments Assessment[]
  dataOwner DataOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, id])
  @@index([ownerId, createdAt])
}

model Item {
  id           String   @id @default(uuid()) @db.Char(36)
  ownerId      String   @db.Char(36)
  wishlistId   String   @db.Char(36)
  name         String   @db.VarChar(160)
  url          String?  @db.VarChar(2048)
  priceMinor   Int?
  quantity     Int
  imageKey     String?  @db.VarChar(255)
  sellerName   String?  @db.VarChar(160)
  createdAt    DateTime @default(now())
  wishlist     Wishlist @relation(fields: [ownerId, wishlistId], references: [ownerId, id], onDelete: Cascade)
  assessments  Assessment[]
  productIdentityId String? @db.Char(36)
  productIdentity   ProductIdentity? @relation(fields: [productIdentityId], references: [id], onDelete: SetNull)
  priceObservations PriceObservation[]
  priceTarget       PriceTarget?
  productImage      ProductImage?

  @@unique([ownerId, wishlistId, id])
  @@index([ownerId, wishlistId, createdAt])
  @@index([productIdentityId])
}

model ProductImage {
  marketplaceIdentityId String? @db.Char(36)
  id        String   @id @db.Char(36)
  ownerId   String   @db.Char(36)
  itemId    String?  @unique @db.Char(36)
  mimeType  String   @db.VarChar(32)
  size      Int      @db.UnsignedInt
  checksum  String   @db.Char(64)
  bytes     Bytes    @db.MediumBlob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([marketplaceIdentityId, createdAt])
}

enum PriceSource {
  existing
  manual
  imported_unverified
  marketplace_verified
}

model PriceObservation {
  marketplaceIdentityId String? @db.Char(36)
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  ownerId     String      @db.Char(36)
  wishlistId  String      @db.Char(36)
  itemId      String      @db.Char(36)
  priceMinor  Int
  currency    String      @db.Char(3)
  source      PriceSource
  observedAt  DateTime    @default(now())
  item        Item        @relation(fields: [ownerId, wishlistId, itemId], references: [ownerId, wishlistId, id], onDelete: Cascade)
  alert       PriceAlert?

  @@index([ownerId, wishlistId, itemId, id])
  @@index([itemId, source, id])
  @@index([marketplaceIdentityId, id])
}

model PriceTarget {
  itemId        String    @id @db.Char(36)
  ownerId       String    @db.Char(36)
  wishlistId    String    @db.Char(36)
  priceMinor    Int
  notify        Boolean   @default(true)
  lastReachedAt DateTime?
  item          Item      @relation(fields: [ownerId, wishlistId, itemId], references: [ownerId, wishlistId, id], onDelete: Cascade)

  @@unique([ownerId, wishlistId, itemId])
}

model PriceAlert {
  id            String           @id @default(uuid()) @db.Char(36)
  observationId BigInt           @unique @db.UnsignedBigInt
  targetMinor   Int
  readAt        DateTime?
  observation   PriceObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([readAt, observationId])
}

enum AssessmentKind {
  impulse
  comparison
  timing
}

model Assessment {
  id          String         @id @default(uuid()) @db.Char(36)
  ownerId     String         @db.Char(36)
  wishlistId  String         @db.Char(36)
  itemId      String?        @db.Char(36)
  kind        AssessmentKind
  version     String         @db.VarChar(24)
  input       Json
  result      Json
  snapshot    Json?
  financial   Json?
  requestKey  String?        @db.Char(36)
  requestHash String?        @db.Char(64)
  createdAt   DateTime       @default(now())
  wishlist    Wishlist       @relation(fields: [ownerId, wishlistId], references: [ownerId, id], onDelete: Cascade)
  item        Item?          @relation(fields: [ownerId, wishlistId, itemId], references: [ownerId, wishlistId, id], onDelete: Cascade)

  @@index([ownerId, wishlistId, itemId, kind, createdAt, id])
  @@unique([ownerId, requestKey])
  @@index([createdAt])
}

model IntelligencePreference {
  ownerId          String @id @db.Char(36)
  coolingOffDays   Int?
  financialContexts Json?
  updatedAt      DateTime @default(now()) @updatedAt
  dataOwner      DataOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model ProductIdentity {
  id              String   @id @default(uuid()) @db.Char(36)
  lookupKey       String   @unique @db.Char(64)
  merchant        String   @db.VarChar(64)
  market          String   @db.VarChar(16)
  listingId       String   @db.VarChar(80)
  canonicalUrl    String   @db.VarChar(2048)
  title           String?  @db.VarChar(160)
  normalizedTitle String?  @db.VarChar(220)
  brand           String?  @db.VarChar(120)
  model           String?  @db.VarChar(120)
  sellerId        String?  @db.VarChar(120)
  variants        Json?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  items           Item[]
  mappings        AffiliateMapping[] @relation("IdentityMappings")
  activeMapping   AffiliateMapping? @relation("ActiveAffiliateMapping")
  audit           AffiliateAudit[]
  notifications   AdminNotification[]

  recommendation  CuratedRecommendation?

  @@index([createdAt, id])
}

enum AffiliateStatus {
  pending
  approved
  rejected
  disabled
  revoked
  invalid
}

enum MatchClassification {
  verified_exact
  potential
  mismatch
  insufficient
}

model AffiliateMapping {
  directReplacement Boolean @default(false)
  id               String @id @default(uuid()) @db.Char(36)
  identityId       String @db.Char(36)
  activeIdentityId String? @unique @db.Char(36)
  originalUrl      String @db.VarChar(2048)
  affiliateUrl     String @db.VarChar(2048)
  candidateKey     String @db.Char(64)
  status           AffiliateStatus @default(pending)
  classification   MatchClassification
  evidence         Json?
  approvedBy       String? @db.VarChar(64)
  approvedAt       DateTime?
  validatedAt      DateTime?
  revision         Int @default(0)
  createdAt        DateTime @default(now())
  identity         ProductIdentity @relation("IdentityMappings", fields: [identityId], references: [id], onDelete: Restrict)
  activeIdentity   ProductIdentity? @relation("ActiveAffiliateMapping", fields: [activeIdentityId], references: [id], onDelete: Restrict)
  audit            AffiliateAudit[]

  @@unique([identityId, candidateKey])
  @@index([identityId, createdAt, id])
}

model AffiliateAudit {
  id         String @id @default(uuid()) @db.Char(36)
  identityId String @db.Char(36)
  mappingId  String @db.Char(36)
  actor      String @db.VarChar(64)
  action     String @db.VarChar(32)
  details    Json
  createdAt  DateTime @default(now())
  identity   ProductIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  mapping    AffiliateMapping @relation(fields: [mappingId], references: [id], onDelete: Restrict)

  @@index([identityId, createdAt, id])
}

model WorkspaceAudit {
  id        String   @id @default(uuid()) @db.Char(36)
  actor     String   @db.VarChar(64)
  action    String   @db.VarChar(40)
  subjectId String   @db.Char(36)
  subject   String   @db.VarChar(160)
  reason    String   @db.VarChar(600)
  createdAt DateTime @default(now())

  @@index([createdAt, id])
}

model AdminNotification {
  id          String @id @default(uuid()) @db.Char(36)
  eventKey    String @unique @db.VarChar(120)
  identityId  String? @db.Char(36)
  kind        String @db.VarChar(32)
  subject     String? @db.VarChar(160)
  targetPath  String? @db.VarChar(255)
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
  identity    ProductIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([dismissedAt, createdAt, id])
  @@index([dismissedAt, readAt, createdAt])
}

model AdminSession {
  tokenHash       String @id @db.Char(64)
  credentialScope String @db.Char(64)
  expiresAt       DateTime

  @@index([expiresAt])
}

enum UserRole {
  member
  admin
}

enum AuthActivityKind {
  signed_in
  signed_out
}

model AuthActivity {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String?          @db.Char(36)
  kind      AuthActivityKind
  provider  AuthProvider?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([userId])
}

model User {
  role        UserRole       @default(member)
  authActivity AuthActivity[]
  password PasswordCredential?
  tokens AccountToken[]
  creatorOnboarding CreatorOnboarding?
  creatorProfile CreatorProfile?
  id          String         @id @default(uuid()) @db.Char(36)
  displayName String?        @db.VarChar(100)
  createdAt   DateTime       @default(now())
  identities  AuthIdentity[]
  sessions    UserSession[]
  dataOwners  DataOwner[]
  financialProfile FinancialProfile?

  @@index([createdAt, id])
}

model FinancialProfile {
  userId              String   @id @db.Char(36)
  income              Json?
  expenses            Json?
  debts               Json?
  savings             Json?
  readiness           Json?
  additional          Json?
  incomeUpdatedAt     DateTime?
  expensesUpdatedAt   DateTime?
  debtsUpdatedAt      DateTime?
  savingsUpdatedAt    DateTime?
  readinessUpdatedAt  DateTime?
  additionalUpdatedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataOwner {
  id         String                  @id @db.Char(36)
  userId     String?                 @db.Char(36)
  user       User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlists  Wishlist[]
  preference IntelligencePreference?

  @@index([userId])
}

enum AuthProvider {
  google
  apple
}

model AuthIdentity {
  verifiedEmail String? @db.VarChar(254)
  avatarUrl     String? @db.VarChar(2048)
  provider    AuthProvider
  subjectHash String       @db.Char(64)
  userId      String       @db.Char(36)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subjectHash])
  @@unique([userId, provider])
}

model UserSession {
  tokenHash           String         @id @db.Char(64)
  userId              String         @db.Char(36)
  pendingGuestOwnerId String?        @db.Char(36)
  expiresAt           DateTime
  verifiedAt          DateTime
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts            OAuthAttempt[]

  @@index([userId])
  @@index([expiresAt])
}

enum AuthPurpose {
  signin
  link
  verify
}

enum AuthDestination {
  account
  admin
  creator
}

model OAuthAttempt {
  destination    AuthDestination?
  stateHash      String       @id @db.Char(64)
  browserHash    String       @db.Char(64)
  provider       AuthProvider
  purpose        AuthPurpose
  nonce          String       @db.VarChar(64)
  verifier       String?      @db.VarChar(128)
  guestOwnerId   String?      @db.Char(36)
  sessionHash    String?      @db.Char(64)
  expiresAt      DateTime
  session        UserSession? @relation(fields: [sessionHash], references: [tokenHash], onDelete: Cascade)

  @@index([sessionHash])
  @@index([expiresAt])
}

enum AccountTokenKind {
  verify
  reset
  changeEmail
}
model PasswordCredential {
  userId       String    @id @db.Char(36)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(120)
  verifiedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AccountToken {
  userId    String           @db.Char(36)
  kind      AccountTokenKind
  tokenHash String           @unique @db.Char(64)
  expiresAt DateTime
  pendingEmail String?      @db.VarChar(254)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, kind])
  @@index([expiresAt])
}
model CreatorOnboarding {
  userId      String   @id @db.Char(36)
  continuedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model CreatorProfile {
  page CreatorPage?
  products CreatorProduct[]
  handle String @unique @default(uuid()) @db.VarChar(36)
  publishedDesign Json?
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @db.Char(36)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorProduct {
  id          String         @id @db.Char(36)
  profileId   String         @db.Char(36)
  profile     CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(160)
  url         String         @db.VarChar(2048)
  description String         @db.VarChar(1000)
  category    String         @db.VarChar(60)
  color       String?        @db.VarChar(60)
  productType String?        @db.VarChar(60)
  priceMinor  Int?
  currency    String?        @db.VarChar(3)
  photo       Bytes?         @db.MediumBlob
  hasPhoto    Boolean        @default(false)
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([profileId, published, createdAt])
}

model CreatorPage {
  profileId String         @id @db.Char(36)
  design    Json
  updatedAt DateTime       @default(now()) @updatedAt
  profile   CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}


enum RecommendationRequestStatus {
  pending
  fulfilled
}

model CuratedRecommendation {
  id             String   @id @default(uuid()) @db.Char(36)
  title          String   @db.VarChar(160)
  url            String   @db.VarChar(2048)
  category       String   @db.VarChar(80)
  color          String?  @db.VarChar(80)
  style          String?  @db.VarChar(80)
  useCase        String?  @db.VarChar(80)
  description    String?  @db.VarChar(1000)
  priceMinor     Int?
  currency       String   @db.Char(3)
  priceVerified  Boolean  @default(false)
  priceVerifiedAt DateTime?
  published      Boolean  @default(false)
  priority       Int      @default(0)
  fulfillmentCursor String? @db.Char(36)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productIdentityId String? @unique @db.Char(36)
  productIdentity ProductIdentity? @relation(fields: [productIdentityId], references: [id], onDelete: Restrict)
  listingUrl     String?  @db.VarChar(2048)
  importedTitle  String?  @db.VarChar(160)
  importedImage  String?  @db.VarChar(2048)
  importedPriceAt DateTime?
  archivedAt     DateTime?

  @@index([published, category, currency])
}

model RecommendationRequest {
  id          String                      @id @default(uuid()) @db.Char(36)
  ownerId     String                      @db.Char(36)
  productKey  String                      @db.Char(64)
  productName String                      @db.VarChar(160)
  sourceCategory String?                  @db.VarChar(80)
  sourcePriceMinor Int?
  sourceCurrency String?                  @db.Char(3)
  sourceColor String?                     @db.VarChar(80)
  status      RecommendationRequestStatus @default(pending)
  createdAt   DateTime                    @default(now())
  fulfilledAt DateTime?
  notices     RecommendationNotice[]

  @@unique([ownerId, productKey])
  @@index([status, productKey])
}

model RecommendationNotice {
  id        String                @id @default(uuid()) @db.Char(36)
  requestId String                @db.Char(36)
  productId String                @db.Char(36)
  readAt    DateTime?
  createdAt DateTime              @default(now())
  request   RecommendationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([requestId, readAt, createdAt])
}
